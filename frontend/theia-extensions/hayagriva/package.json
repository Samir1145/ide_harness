{
  "name": "hayagriva-theia-extension",
  "version": "0.1.0",
  "description": "Hayagriva integration for Theia: upload, wiki viewer, RAG chat",
  "keywords": [
    "theia",
    "hayagriva",
    "wiki",
    "rag"
  ],
  "license": "MIT",
  "theiaExtensions": [
    {
      "frontend": "lib/browser/hayagriva-frontend-module",
      "backend": "lib/electron-main/hayagriva-electron-main-module"
    }
  ],
  "dependencies": {
    "@theia/ai-core-ui": "1.75.0",
    "@theia/core": "1.75.0",
    "@theia/editor": "1.75.0",
    "@theia/filesystem": "1.75.0",
    "@theia/monaco": "1.75.0",
    "@theia/workspace": "1.75.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vscode-ws-jsonrpc": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "rimraf": "^2.7.1",
    "typescript": "^4.9.5"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf lib *.tsbuildinfo",
    "watch": "tsc -b --watch"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
