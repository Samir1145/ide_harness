PORT=3400
NODE_ENV=development

# Per-vault AES-256-GCM keys (64-char hex each)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAULT_KEY_LAWS=
VAULT_KEY_CASES=
VAULT_KEY_DOCUMENTS=
VAULT_KEY_FORMS=

# Optional: path to latest.json served by GET /vaults/latest.json
# Defaults to ./data/latest.json
# LATEST_JSON_PATH=/path/to/latest.json

# Optional: path to licenses.db
# Defaults to ./licenses.db
# DB_PATH=/path/to/licenses.db
