#!/bin/bash

# TWILLM Launcher - Embedded in App Bundle

# Robust PATH setup for macOS environment
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

# Load NVM (Node Version Manager) if installed
export NVM_DIR="$HOME/.nvm"
if [ -s "$NVM_DIR/nvm.sh" ]; then
    . "$NVM_DIR/nvm.sh"
fi

# Source standard profiles as fallback
if [ -f "$HOME/.zprofile" ]; then
    source "$HOME/.zprofile"
fi
if [ -f "$HOME/.zshrc" ]; then
    source "$HOME/.zshrc"
fi
if [ -f "$HOME/.profile" ]; then
    source "$HOME/.profile"
fi

set -e

TWILLM_DIR="/Users/atulgrover/Desktop/TWILLM/twillm"
THEIA_DIR="/Users/atulgrover/Desktop/TWILLM/ide/applications/electron"
PORT=3210

# Check if twillm proxy is already running
if lsof -Pi :$PORT -sTCP:LISTEN -t >/dev/null 2>&1 ; then
    echo "[Launcher] twillm already running on port $PORT"
else
    echo "[Launcher] Starting twillm..."
    cd "$TWILLM_DIR"
    nohup node cli.js --watch-all > /tmp/twillm.log 2>&1 &
    TWILLM_PID=$!
    echo "[Launcher] twillm started (PID: $TWILLM_PID)"
    
    # Wait for twillm to be ready
    for i in {1..30}; do
        if lsof -Pi :$PORT -sTCP:LISTEN -t >/dev/null 2>&1 ; then
            echo "[Launcher] twillm ready on port $PORT"
            break
        fi
        sleep 1
    done
fi

# Start THEIA
echo "[Launcher] Starting THEIA..."
cd "$THEIA_DIR"
unset ELECTRON_RUN_AS_NODE
yarn start

# Clean up all background servers when user quits the app
/Users/atulgrover/Desktop/TWILLM/stop.command
